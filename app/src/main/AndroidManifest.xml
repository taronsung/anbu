<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- Pleos Vehicle SDK: 읽기 전용 권한만 쓴다. 차량을 제어하는 권한은 없다. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />   <!-- 브레이크, 주행거리 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />  <!-- 전조등 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />  <!-- 에어백, 안전띠 경고 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />   <!-- 안전띠 체결 -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" /> <!-- 와이퍼(앞유리 영역). 비 오는 날 운전 비율에 쓴다 -->

    <!-- Pleos NaviHelper / FusedLocation / TextToSpeech / SpeechToText -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <!-- AAOS Car API: 기어(일반 권한), 속도(실행 중 허용) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!-- 가족 화면 릴레이로 안부 요약을 보낸다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AnbuApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anbu">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">

            <!-- 주행 중에도 최소 화면을 보여 주기 위한 선언. 실제 제한은 CarUxRestrictions를 따른다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Gleo AI 액션 (assets/schema.json의 function 이름과 같다) -->
            <intent-filter>
                <action android:name="SEND_DEPARTURE_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="SEND_ARRIVAL_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="READ_WEEKLY_DIARY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
